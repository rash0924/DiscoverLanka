# Google Maps API Key (restricted to your domain)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API URL
VITE_API_BASE_URL=http://localhost:3001/api

# OpenWeather API Key (for weather feature)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# App Config
VITE_APP_NAME=LankaExplore
VITE_APP_URL=http://localhost:5173

# Supabase project settings (the publishable key is safe for browser use;
# never put a service_role key in a VITE_ variable or commit it to source control).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
